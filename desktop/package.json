{
  "name": "carevance-desktop",
  "version": "1.2.5",
  "description": "CareVance Tracker desktop timer and activity tracker",
  "private": true,
  "author": "CareVance",
  "main": "main.cjs",
  "scripts": {
    "prepare:app-config": "node scripts/write-app-config.cjs",
    "prepare:renderer": "node scripts/prepare-renderer.cjs",
    "prepare:browser-extension": "node scripts/sync-browser-extension.cjs",
    "start": "npm run prepare:app-config && npm run prepare:browser-extension && node scripts/run-electron.cjs .",
    "pack": "node scripts/write-app-config.cjs --require-remote && npm run prepare:browser-extension && npm run prepare:renderer && electron-builder --dir --config.directories.output=release-v%npm_package_version%",
    "dist:win": "node scripts/write-app-config.cjs --require-remote && npm run prepare:browser-extension && npm run prepare:renderer && electron-builder --win nsis --config.directories.output=release-v%npm_package_version%",
    "dist:portable": "node scripts/write-app-config.cjs --require-remote && npm run prepare:browser-extension && electron-builder --win portable --config.directories.output=release-v%npm_package_version%",
    "test": "node --test \"tests/*.test.cjs\""
  },
  "build": {
    "appId": "com.carevance.tracker",
    "productName": "CareVance Tracker",
    "icon": "assets/icon.ico",
    "files": [
      "main.cjs",
      "preload.cjs",
      "auto-start.cjs",
      "idle-popup.cjs",
      "idle-popup-preload.cjs",
      "idle-popup/**/*",
      "quick-reply-popup.cjs",
      "quick-reply-preload.cjs",
      "quick-reply/**/*",
      "browser-tracking-bridge.cjs",
      "browser-tracking-install-guide.cjs",
      "browser-url/**/*",
      "app-config.json",
      "offline/**/*",
      "diagnostics/**/*",
      "renderer/**/*",
      "scripts/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release-v${version}"
    },
    "asarUnpack": [
      "browser-url/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Igrisssssss",
        "repo": "carevance_hrms",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "CareVance-Tracker-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CareVance Tracker",
      "deleteAppDataOnUninstall": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "runAfterFinish": false
    }
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "get-windows": "^9.3.0",
    "sql.js": "^1.11.0"
  }
}
