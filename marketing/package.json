{
  "name": "marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "sync:pt": "node scripts/sync-pt-states.mjs",
    "sync": "npm run sync:tokens && npm run sync:pt",
    "verify:calc": "tsx scripts/verify-calc.ts",
