{
  "expo": {
    "name": "CareVance HRMS",
    "slug": "carevance-ios-build",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "carevance",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to mark attendance and verify you are within the geofence zone.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Background location is used for live GPS tracking during work hours.",
        "NSCameraUsageDescription": "Camera is used for attendance selfie verification.",
        "NSPhotoLibraryAddUsageDescription": "Photo library access is used to save payslip PDFs.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.carevance.hrms"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "package": "com.carevance.hrms",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-camera",
      "expo-secure-store",
      "expo-notifications",
      "react-native-bottom-tabs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9993712d-7d7c-4256-8e4b-54fa349c186c"
      }
    },
    "owner": "carevance_ayush"
  }
}
